# ============================================================
# Terraform
# ============================================================

# Terraform working directories and downloaded providers
**/.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable values (may contain secrets)
*.tfvars
*.tfvars.json

# Terraform plan files
*.tfplan
tfplan

# Terraform crash logs
crash.log
crash.*.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Keep Terraform provider dependency lock file tracked
!.terraform.lock.hcl
